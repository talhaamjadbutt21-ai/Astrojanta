NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Postgres connection string. Leave empty in development to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# Comma-separated origins allowed to call the API with credentials (web app, Expo web).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

SESSION_TTL_DAYS=30

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Changing it makes existing encrypted birth data unreadable.
DATA_ENCRYPTION_KEY=

# Set true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# AI astrologer. Without a key, the API runs in "offline" mode with chart-based summaries.
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
FREE_DAILY_QUESTIONS=5
