{
  "name": "sebt-ai",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev -w @sebt/api",
    "dev:web": "npm run dev -w @sebt/web",
    "dev:mobile": "npm run start -w @sebt/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
