NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Production: set NODE_ENV=production and put this API behind HTTPS (TRUST_PROXY=true).
# CORS_ORIGINS and the web app NEXT_PUBLIC_SITE_URL must be https://your-domain.

# Postgres. Leave empty in development to use embedded PGlite in .data/pglite.
# Production (Supabase): transaction pooler port 6543, prepare disabled automatically.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct URL (port 5432) when DATABASE_URL is the pooler. Used by `npm run db:migrate -w @astrojanta/api`.
# DATABASE_MIGRATE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_MIGRATE_URL=

# Template only — the API does not load this file. Copy it to apps/api/.env and put real keys there.
# Supabase Auth (Project Settings → API). The web app never uses these keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to call the API with credentials (include https://your-domain).
CORS_ORIGINS=http://localhost:3000

# Comma-separated emails that can open /admin. Empty = nobody is admin.
ADMIN_EMAILS=

SESSION_TTL_DAYS=30

# 32 random bytes, base64. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Set true when running behind a reverse proxy / load balancer (required on most hosts).
TRUST_PROXY=false

# Required in production. Chat is live if GEMINI_API_KEY or OPENAI_API_KEY is set.
# Google AI Studio (AIza...) or OpenRouter (sk-or-v1-...) for Gemma 4 26B A4B.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemma-4-26b-a4b-it
GUEST_DAILY_ATTEMPTS=3
GUEST_KUNDLI_DAILY_ATTEMPTS=1
FREE_DAILY_QUESTIONS=2
PRO_DAILY_QUESTIONS=6

# Inbox for Pro requests. You send a payment link by hand, then grant Pro in /admin.
PRO_REQUEST_EMAIL=pro-requests@example.com

# Transactional email via Resend (https://resend.com). Required to email payment links / Pro status.
# Free accounts can only send to the Resend account email until you verify a domain.
RESEND_API_KEY=
# Verified sender, e.g. Astrojanta <hello@yourdomain.com>
# For Resend sandbox testing: Astrojanta <onboarding@resend.dev>
MAIL_FROM=

# Optional: included in the customer's Pro request email so they can pay without waiting.
# PRO_PAYMENT_LINK_MONTHLY=https://pay.example.com/monthly
# PRO_PAYMENT_LINK_YEARLY=https://pay.example.com/yearly
