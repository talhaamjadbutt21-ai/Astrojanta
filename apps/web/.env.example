# Server-side only: where Next.js proxies /api/* requests.
# Production: https://api.your-domain.com  (or the same origin if you reverse-proxy /api)
API_URL=http://localhost:4000

# Public canonical URL used for metadata, sitemap, robots and Open Graph.
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

